{
  "name": "@plone/nick-example-addon",
  "description": "Example add-on for Nick: a content type, a behavior, a REST service, a periodic task and its own tables and migrations",
  "type": "module",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git@github.com:plone/nick.git"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nick": {
    "profiles": "src/profiles",
    "migrations": "src/migrations",
    "schema": "example"
  },
  "keywords": [
    "nick",
    "nick-addon"
  ],
  "engines": {
    "node": "^22 || ^24 || ^25 || ^26"
  },
  "peerDependencies": {
    "@plone/nick": "workspace:^"
  },
  "devDependencies": {
    "@plone/nick": "workspace:^"
  }
}
